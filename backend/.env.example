PORT=3000
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EXPIRES_IN=1h

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# SMTP / Nodemailer
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASSWORD=your-16-character-google-app-password
EMAIL_FROM_NAME=Feature Flag API
EMAIL_FROM_ADDRESS=your-gmail-address@gmail.com

# Application
APP_NAME=Feature Flag API
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# OTP
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
PASSWORD_RESET_OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Production Docker Compose. Replace both example origins before deployment.
PUBLIC_DOMAIN=api.example.com
PRODUCTION_FRONTEND_URL=https://app.example.com
SECRETS_DIR=./secrets
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Create these files under SECRETS_DIR; never put their contents in this file:
# mongo_uri (TLS-enabled URI for a least-privilege MongoDB user)
# jwt_secret
# jwt_access_secret
# jwt_refresh_secret
# redis_password
# google_client_secret (empty only if Google sign-in is unused)
# email_password (empty only if outbound email is unused)
